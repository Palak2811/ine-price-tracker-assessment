{
  "name": "ine-price-tracker-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "scrape": "node scripts/scrape-cli.js",
    "scrape:headed": "node scripts/scrape-cli.js --headed --slow-mo=350",
    "sync:catalog": "node scripts/sync-catalog.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "playwright": "1.49.1"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
