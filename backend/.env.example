# ---------------------------------------------------------------------------
# Backend environment variables
# Copy to .env and fill in. NEVER commit .env -- it is gitignored.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service-role key. Bypasses Row Level Security, so it is SERVER-ONLY.
# Never expose this to the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the external cron service must present to POST /api/cron/scrape.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Comma-separated list of origins allowed to call this API (the Vercel URL).
# Example: https://my-app.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Max products scraped concurrently in one run. Keep small: each one drives a
# real browser context, and Render's free tier has limited memory.
SCRAPE_CONCURRENCY=2
